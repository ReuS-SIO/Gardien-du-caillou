[node name="StoryTitle" type="Label" parent="StoryPanel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.85, 0.4, 1)
theme_override_font_sizes/font_size = 16
text = "Kouaoua, Nouvelle-Calédonie"
horizontal_alignment = 1

[node name="StoryText" type="Label" parent="StoryPanel/VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_font_sizes/font_size = 11
text = "Un groupe de chercheurs découvre un mystérieux minerai dans la montagne de Kouaoua. Persuadés de tenir une découverte majeure, ils ignorent qu'il contient une substance dangereuse.

Peu à peu, l'eau et les plantes des alentours sont contaminées. Les animaux vivant près de la mine se transforment : certains grandissent démesurément, changent de couleur ou acquièrent des capacités inhabituelles.

Quand des mutants apparaissent près du village, les chercheurs comprennent que le minerai est en cause. Vous êtes le gardien : traversez les cinq zones, repoussez les vagues de mutants et terrassez les boss pour stopper la contamination avant qu'elle ne touche toute la faune du Caillou."
autowrap_mode = 3

[node name="CloseButton" type="Button" parent="StoryPanel/VBox"]
layout_mode = 2
size_flags_horizontal = 4
text = "Fermer"

[node name="Version" type="Label" parent="."]
layout_mode = 1
